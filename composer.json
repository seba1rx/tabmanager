{
    "name": "seba1rx/tabmanager",
    "description": "Per-tab PHP session isolation — each browser tab gets its own namespaced $_SESSION slot via a UUIDv4 header",
    "type": "library",
    "license": "MIT",
    "keywords": ["session", "tab", "isolation", "per-tab", "uuid", "php"],
    "authors": [
        {
            "name": "Sebastián Basilio",
            "email": "seba.1rx@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Seba1rx\\TabManager\\": "src/"
        },
        "files": [
            "bin/bootstrap.php"
        ]
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "post-install-cmd": [
            "php -r \"copy(__DIR__.'/assets/seba1rx_tabmanagerclient.js', getcwd().'/seba1rx_tabmanagerclient.js');\""
        ],
        "post-update-cmd": [
            "php -r \"copy(__DIR__.'/assets/seba1rx_tabmanagerclient.js', getcwd().'/seba1rx_tabmanagerclient.js');\""
        ]
    },
    "require": {
        "php": ">=8.1"
    },
    "suggest": {
        "seba1rx/sessionadmin": "Provides TabHandlerInterface — required to use SessionAdminBridge for integration with seba1rx/sessionadmin."
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Seba1rx\\TabManager\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
